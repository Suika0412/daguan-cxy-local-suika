[Unit]
Description=Daguan CXY GitHub auto-update check
Wants=network-online.target
After=network-online.target daguan-cxy.service

[Service]
Type=oneshot
User=root
WorkingDirectory=__ROOT__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DAGUAN_UPDATE_USER=__UPDATE_USER__
ExecStart=/usr/bin/bash __ROOT__/scripts/auto-update-linux.sh
